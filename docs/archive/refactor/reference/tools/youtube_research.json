{
  "tool": "youtube_research",
  "notCalled": "calls YouTube",
  "inputSchema": {
    "type": "object",
    "properties": {
      "query": {
        "description": "Search phrase (e.g. commander name).",
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "video": {
        "description": "YouTube URL or 11-char video ID.",
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "kind": {
        "default": "deck_tech",
        "description": "Search intent: 'deck_tech', 'guide', 'gameplay', or 'any'.",
        "type": "string",
        "enum": ["deck_tech", "guide", "gameplay", "any"]
      },
      "sortBy": {
        "default": "balanced",
        "description": "Ranking: 'balanced', 'relevance', 'views', or 'recent'.",
        "type": "string",
        "enum": ["balanced", "relevance", "views", "recent"]
      },
      "limit": {
        "default": 5,
        "description": "Max videos to return (1-10).",
        "type": "integer",
        "minimum": 1,
        "maximum": 10
      },
      "lang": {
        "default": "en",
        "description": "Caption language code.",
        "type": "string",
        "minLength": 2,
        "maxLength": 12
      },
      "includeTimestamps": {
        "default": false,
        "description": "Include [MM:SS] timestamps.",
        "type": "boolean"
      },
      "cursor": {
        "default": 0,
        "description": "Segment cursor for long transcripts.",
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    }
  }
}
