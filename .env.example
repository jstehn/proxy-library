# Settings for docker compose. Copy to .env and fill in. (Development uses .envrc instead.)

# Signs session cookies. At least 32 random characters: `openssl rand -hex 32`.
AUTH_SECRET=
# The address players use to reach the app (used in invite links and cookies).
APP_URL=http://localhost:3000
# The port on this machine the app listens on.
PORT=3000
# The database password (the database only listens inside Docker's network).
POSTGRES_PASSWORD=change-me
# When the nightly catalog sync runs, as HH:MM in the TZ below.
SYNC_TIME=04:00
TZ=UTC
