# shellcheck shell=bash
# Loaded automatically by direnv when you cd into this directory.
use flake

# Project-local Postgres: data dir and Unix socket live in ./.dev (gitignored).
export PGDATA="$PWD/.dev/pgdata"
export PGHOST="$PWD/.dev"
export PGUSER=tcg
export PGDATABASE=tcg
export DATABASE_URL="postgres://tcg@localhost/tcg?host=$PWD/.dev"
export TEST_DATABASE_URL="postgres://tcg@localhost/tcg_test?host=$PWD/.dev"
export E2E_DATABASE_URL="postgres://tcg@localhost/tcg_e2e?host=$PWD/.dev"

# Where downloaded card images are cached.
export IMAGE_CACHE_DIR="$PWD/.dev/images"

# Where players open the app, and the key that signs session cookies. The development secret
# is generated once (random) and kept in .dev/, which is gitignored.
export APP_URL="http://localhost:3000"
mkdir -p "$PWD/.dev"
if [[ ! -s "$PWD/.dev/auth-secret" ]]; then
  head -c 48 /dev/urandom | base64 | tr -d '\n' > "$PWD/.dev/auth-secret"
fi
AUTH_SECRET="$(< "$PWD/.dev/auth-secret")"
export AUTH_SECRET

# Personal overrides / secrets (not committed).
dotenv_if_exists .env.local
