{
  "name": "tcg-virtual-library",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:start": "scripts/db.sh start",
    "db:stop": "scripts/db.sh stop",
    "db:status": "scripts/db.sh status",
    "db:reset": "scripts/db.sh reset",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest --project unit",
    "test:int": "vitest run --project integration",
    "test:all": "vitest run --project unit --project integration",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && vitest run --project unit",
    "worker": "tsx worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx worker/index.ts migrate",
    "test:e2e": "playwright test",
    "test:remote": "vitest run --project remote"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.6",
    "better-auth": "1.7.6",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-plugin-boundaries": "^7.2.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.3.4",
  "type": "module"
}
