# Your own server's settings for scripts/deploy.sh. Copy to deploy/local.env (git-ignored) and
# fill in. Kept out of the repository because they describe your network.

# The Docker server, as you'd reach it with ssh (a host name, an ssh alias, or an address).
DEPLOY_HOST=your-server
# The address players use, through your reverse proxy (invite links and cookies use it).
DEPLOY_APP_URL=https://proxylib.example.com
# The port on the server the app listens on (used only when the stack is first created).
DEPLOY_PORT=3470
# The time zone for the nightly sync (used only when the stack is first created).
DEPLOY_TZ=UTC
# Portainer's address, if it isn't https://<DEPLOY_HOST>:9443.
# PORTAINER_URL=https://your-server:9443
